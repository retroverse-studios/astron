{
  "name": "@astron/interpret",
  "version": "0.1.0",
  "description": "ASTRON interpretation layer \u2014 readings assembled from named parts through LIGHT/TRUTH/SHADOW lenses, with the parts always shown.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./narrators/*": {
      "types": "./dist/narrators/*.d.ts",
      "default": "./dist/narrators/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@astron/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
